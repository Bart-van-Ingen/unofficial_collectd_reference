{
    // EDITOR SETTINGS
    "editor.tabSize": 4,
    "editor.rulers": [
        99
    ],
    "editor.renderWhitespace": "all",
    "editor.formatOnSave": true,
    "editor.formatOnType": true,
    "editor.codeActionsOnSave": {
        "source.organizeImports": "explicit"
    },
    // Everything below is regenerated by "uv run collectd-docs" (docs/, snippets/, site/) or is a
    // pinned upstream checkout (.cache/). Keep it out of search, watching, and accidental edits.
    "files.watcherExclude": {
        "**/.cache/**": true,
        "**/.venv/**": true,
        "**/docs/**": true,
        "**/site/**": true,
        "**/snippets/**": true
    },
    "search.exclude": {
        ".cache": true,
        ".venv": true,
        "docs": true,
        "site": true,
        "snippets": true,
        "uv.lock": true
    },
    "files.readonlyInclude": {
        ".cache/**": true,
        "docs/**": true,
        "site/**": true,
        "snippets/**": true
    },
    // PYTHON SETTINGS
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "python.terminal.activateEnvironment": true,
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "python.analysis.completeFunctionParens": true,
    "python.analysis.autoFormatStrings": true,
    // "tools" is imported as a package (see [project.scripts] in pyproject.toml), so resolve it
    // from the workspace root rather than from the installed copy in .venv/.
    "python.analysis.extraPaths": [
        "${workspaceFolder}"
    ],
    "python.analysis.typeCheckingMode": "basic",
    // No test suite yet; re-enable pytest here if one is added under tools/.
    "python.testing.unittestEnabled": false,
    "python.testing.pytestEnabled": false,
    // MARKDOWN SETTINGS
    // Only content/ is hand-written; formatting on save is off so a stray save cannot reflow a
    // page in ways that change the rendered output. Format explicitly when you want it.
    "[markdown]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": false,
        "editor.wordWrap": "bounded",
        "editor.wordWrapColumn": 99,
        "editor.renderWhitespace": "trailing"
    },
    // TOML / JSON SETTINGS
    // zensical.toml carries a generated nav block between BEGIN/END GENERATED NAV markers.
    "[toml]": {
        "editor.formatOnSave": false
    },
    "[jsonc]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features"
    },
    // GIT GRAPH SETTINGS
    "git-graph.maxDepthOfRepoSearch": 1,
}
